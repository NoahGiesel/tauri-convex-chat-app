{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chat",
  "version": "../package.json",
  "identifier": "dev.NoahGiesel.chat",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Chat",
        "width": 1100,
        "height": 720,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ1MkY1QUVEMDEwQzlBN0IKUldSN21nd0I3Vm92MVQ1WVNyOGhWZ3BpNnFQZVhVSTJ0d2N4Z0NtZ3ZjaXh1Qmo4ZHAxZWJWYnQK",
      "endpoints": [
        "https://github.com/NoahGiesel/tauri-convex-chat-app/releases/latest/download/latest.json"
      ],
      "windows": { "installMode": "passive" }
    }
  }
}
